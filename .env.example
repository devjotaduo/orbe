# Copy this file to .env and fill only the variables you need.
# Do not commit real access keys, tokens, or secrets.

# Alibaba Cloud / CloudPaw
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ALIBABA_CLOUD_REGION_ID=cn-hangzhou

# Alibaba Model Studio / DashScope LLM and media tools
DASHSCOPE_API_KEY=
QWENPAW_DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=
DASHSCOPE_BASE_URLS=

# Optional iac-code override. Leave blank to let CloudPaw use QwenPaw's
# configured model provider.
IAC_CODE_PROVIDER=
IAC_CODE_MODEL=
IAC_CODE_API_KEY=

# AgentExplorer / marketplace integration
ALIYUN_AGENTEXPLORER_ENDPOINT=

# CI/release only. Prefer GitHub repository secrets for these values.
ALIYUN_ACR_USERNAME=
ALIYUN_ACR_PASSWORD=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=
